{
  "version": "3.0",
  "defaultProvider": "unpkg",
  "libraries": [
    {
      "library": "bootstrap@5.3.2",
      "destination": "wwwroot/lib/bootstrap/",
      "files": [
        "dist/css/bootstrap.min.css",
        "dist/js/bootstrap.bundle.min.js"
      ]
    },
    {
      "library": "jquery@3.7.1",
      "destination": "wwwroot/lib/jquery/",
      "files": [ "dist/jquery.min.js" ]
    },
    {
      "library": "jquery-validation@1.19.5",
      "destination": "wwwroot/lib/jquery-validation/",
      "files": [ "dist/jquery.validate.min.js" ]
    },
    {
      "library": "jquery-validation-unobtrusive@4.0.0",
      "destination": "wwwroot/lib/jquery-validation-unobtrusive/",
      "files": [ "dist/jquery.validate.unobtrusive.min.js" ]
    },
    {
      "library": "tabulator-tables@5.5.2",
      "destination": "wwwroot/lib/tabulator/"
    },
    {
      "library": "sweetalert2@11",
      "destination": "wwwroot/lib/sweetalert2/",
      "files": [
        "dist/sweetalert2.min.css",
        "dist/sweetalert2.all.min.js"
      ]
    },
    {
      "library": "bootstrap-icons@1.11.3",
      "destination": "wwwroot/lib/bootstrap-icons/",
      "files": [
        "font/bootstrap-icons.css",
        "font/fonts/bootstrap-icons.woff2",
        "font/fonts/bootstrap-icons.woff"
      ]
    },
    {
      "library": "datatables.net@1.13.8",
      "destination": "wwwroot/lib/datatables.net/",
      "files": [ "js/jquery.dataTables.min.js" ]
    },
    {
      "library": "datatables.net-bs5@1.13.8",
      "destination": "wwwroot/lib/datatables.net-bs5/",
      "files": [
        "css/dataTables.bootstrap5.min.css",
        "js/dataTables.bootstrap5.min.js"
      ]
    }
  ]
}