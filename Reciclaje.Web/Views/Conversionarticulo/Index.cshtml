@model IEnumerable<Reciclaje.Aplicacion.DTOs.Reciclaje.ConversionarticuloDto>

@{
    ViewData["Titulo"] = "Conversión de Artículos";
}

<div class="panel-contenedor">

    <!-- ── Header ── -->
    <div class="panel-principal">
        <h5><i class="bi bi-arrow-repeat"></i> Conversión de Artículos</h5>
    </div>

    <!-- ── Barra de acciones ── -->
    <div class="barra-acciones">
        <a asp-action="Crear" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg"></i> Nueva Conversión
        </a>
    </div>

    <!-- ── Tabla ── -->
    <div class="panel-tabla">

        @if (TempData["Exito"] != null)
        {
            <div class="d-flex align-items-center gap-2 mx-3 mt-3 p-2 rounded"
                 style="background:#EAF3DE; border-left:3px solid #3B6D11;
                            color:#3B6D11; font-size:13px; font-weight:500;">
                <i class="bi bi-check-circle-fill"></i> @TempData["Exito"]
            </div>
        }

        <table id="tblConversiones" class="tabla-corporativa w-100">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Art. No Inventariado</th>
                    <th>Art. Reciclaje</th>
                    <th>Descripción</th>
                    <th>Creado por</th>
                    <th>Modificado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <span class="badge badge-registrado"
                                  style="font-family:'Courier New',monospace;">
                                #@item.ConversionId
                            </span>
                        </td>
                        <td>
                            <span class="badge badge-enviado">
                                @item.ArticuloNoInventariado
                            </span>
                        </td>
                        <td>
                            <span class="badge badge-enviado">
                                @item.ArticuloReciclaje
                            </span>
                        </td>
                        <td>@item.DescripcionArticuloReciclaje</td>
                        <td>
                            <span>@(item.UsuarioCreacionAudit ?? "—")</span><br />
                            <span class="text-muted" style="font-size:11px;">
                                @(item.FechaCreacionAudit?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                            </span>
                        </td>
                        <td>
                            <span>@(item.UsuarioModificacionAudit ?? "—")</span><br />
                            <span class="text-muted" style="font-size:11px;">
                                @(item.FechaModificacionAudit?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                            </span>
                        </td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-action="Editar" asp-route-id="@item.ConversionId"
                                   class="btn btn-warning btn-sm">
                                    <i class="bi bi-pencil"></i> Editar
                                </a>
                                <a asp-action="Eliminar" asp-route-id="@item.ConversionId"
                                   class="btn btn-danger btn-sm">
                                    <i class="bi bi-trash"></i> Eliminar
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('#tblConversiones').DataTable({
                language: {
                    url: 'https://cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json'
                },
                pageLength: 10,
                lengthMenu: [[10, 25, 50, -1], [10, 25, 50, 'Todos']],
                order: [[0, 'desc']],
                columnDefs: [
                    { orderable: false, targets: 6 }
                ],
                responsive: true,
                autoWidth: false
            });
        });
    </script>
}
