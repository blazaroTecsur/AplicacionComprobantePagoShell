{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Loggings": {
    "Path": "/app/logs"
  },
  "Storages": {
    "Path": "/app/storage"
  },
  "AzureAd": {
    "Corporate": {
      "Authority": "",
      "ClientId": "",
      "ClientSecret": "",
      "CallbackPath": ""
    },
    "External": {
      "Authority": "",
      "ClientId": "",
      "ClientSecret": "",
      "CallbackPath": ""
    }
  },
  "ApiSettings": {
    "Seguridad": {
      "ScopeCorporate": "",
      "ScopeExternal": "",
      "BaseUrl": "http://localhost:5216/",
      //"BaseUrl": "http://10.160.9.17:8012/",
      "Endpoints": {
        "Autenticar": "",
        "Actualizar": ""
      }
    }
  },
  "AppBaseUrl": "https://localhost:7070/",
  //"AppBaseUrl": "https://10.160.9.17:4013/",
  "ReverseProxy": {
    "Routes": {
      "legacy-route": {
        "ClusterId": "legacy-cluster",
        "Match": {
          "Path": "/legacy/{**catch-all}"
        }
      },
      "resguardo-route": {
        "ClusterId": "resguardo-cluster",
        "Match": {
          "Path": "/resguardo/{**catch-all}"
        }
      },
      "comprobante-route": {
        "ClusterId": "comprobante-cluster",
        "Match": {
          "Path": "/comprobante/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "legacy-cluster": {
        "Destinations": {
          "dest1": {
            "Address": "https://localhost:44362/"
          }
        }
      },
      "resguardo-cluster": {
        "Destinations": {
          "dest1": {
            "Address": "https://localhost:7168/"
            //"Address": "http://10.160.9.17:8010/"
          }
        }
      },
      "comprobante-cluster": {
        "Destinations": {
          "dest1": {
            "Address": "https://localhost:7168/"
          }
        }
      }
    }
  }
}