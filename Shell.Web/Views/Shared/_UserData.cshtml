
<div class="modal fade" id="layoutUpdateModal" tabindex="-1"
     aria-labelledby="layoutUpdateModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content"
             style="border:none; border-radius:var(--radius-lg); overflow:hidden; box-shadow:var(--shadow-lg);">

            <div style="background:var(--corp-blue); padding:16px 20px;
                display:flex; align-items:center; justify-content:space-between;">
                <div style="font-family:var(--font-display); font-weight:var(--fw-bold);
                    font-size:var(--text-base); color:#fff;
                    display:flex; align-items:center; gap:8px;"
                     id="layoutUpdateModalTitle">
                    <i class="bi bi-person-fill-gear" aria-hidden="true"></i>
                    Actualizar Datos Personales
                </div>
                <button style="background:rgba(255,255,255,.15); border:none; width:30px; height:30px;
                    border-radius:var(--radius-sm); color:#fff; cursor:pointer;
                    display:flex; align-items:center; justify-content:center; font-size:.9rem;
                    transition:background var(--transition-fast);"
                        onmouseover="this.style.background='rgba(255,255,255,.28)'"
                        onmouseout="this.style.background='rgba(255,255,255,.15)'"
                        data-bs-dismiss="modal" aria-label="Cerrar">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>

            <div style="padding:24px;">

                <div class="alert alert-warning" role="alert">                    
                    <p class="mb-0"><i class="bi bi-info-circle"></i>&nbsp;&nbsp;Complete sus datos básicos para continuar. Esta información es necesaria para habilitar el acceso a las funcionalidades del sistema.</p>
                </div>
                <hr />
                <div class="row">
                    <div class="col-6">
                        <div class="corp-field">
                            <label class="corp-field__label">DNI</label>
                            <input type="text" id="master_txtTitulo" class="corp-input"
                                   value="@Model.Dni"
                                   maxlength="8"
                                   placeholder="Ingrese su DNI" />
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="corp-field">
                            <label class="corp-field__label">Nombres y Apellidos</label>
                            <input type="text" id="master_txtTitulo" class="corp-input"
                                   value="@Model.Titulo"
                                   placeholder="Ej: Pedro Martínez Vélez"
                                   disabled />
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="corp-field">
                            <label class="corp-field__label">Correo Electrónico</label>
                            <input type="email" id="master_txtCorreo" class="corp-input"
                                   value="@Model.Correo"
                                   placeholder="Ej: email@corporativo.pe"
                                   disabled />
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="corp-field">
                            <label class="corp-field__label">Empresa</label>
                            <input type="text" id="master_txtEmpresa" class="corp-input"
                                   value="@Model.Empresa"
                                   maxlength="11"
                                   placeholder="Ej: 20601088186" />
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="corp-field">
                            <label class="corp-field__label">Departamento (CR)</label>
                            <input type="text" id="master_txtDepartamento" class="corp-input"
                                   value="@Model.Departamento"
                                   maxlength="4"
                                   placeholder="Ej. 2810" />
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="corp-field">
                            <label class="corp-field__label">Puesto</label>
                            <input type="text" id="master_txtPuesto" class="corp-input"
                                   value="@Model.Puesto"
                                   maxlength="50"
                                   placeholder="Ej. Analista Comercial" />
                        </div>
                    </div>
                </div>
                <div style="display:flex; gap:10px; justify-content:flex-end; margin-top:20px;">
                    <button class="corp-btn corp-btn--ghost" data-bs-dismiss="modal">Cancelar</button>
                    <button class="corp-btn corp-btn--primary" id="layoutBtnGuardarUpd"
                            onclick="Layout.guardarActualizacion()">
                        <i class="bi bi-check-lg" aria-hidden="true"></i> Guardar cambios
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>